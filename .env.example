APP_ENV=development
PORT=3000
RUST_LOG=info,ai_server=debug,tower_http=debug

LLM_API_BASE=https://api.deepseek.com/v1
LLM_API_KEY=sk-your-key-here
LLM_MODEL=deepseek-chat
