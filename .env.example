# LLM_REASONING_API_BASE=
# LLM_REASONING_API_KEY=

# Local development credentials; keep these consistent with docker-compose.yml.
DATABASE_URL=postgres://ai_saas:ai_saas_dev@127.0.0.1:5432/ai_saas
