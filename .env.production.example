# ------------------------------------------------------------------------------
# Production Environment Configuration Template (.env.production.example)
# Copy to .env.production on your deployment server / cloud platform
# ------------------------------------------------------------------------------

# Application Environment
APP_ENV=production
PORT=3000
RUST_LOG=info,ai_server=info,tower_http=warn

# PostgreSQL Connection String (replace with your managed DB or docker service)
DATABASE_URL=postgres://ai_saas:YOUR_STRONG_PASSWORD@postgres:5432/ai_saas

# Allowed CORS Origins (comma-separated, include your frontend domain/Vercel URL)
CORS_ALLOW_ORIGINS=https://your-frontend-domain.vercel.app,http://localhost:3000,http://127.0.0.1:3000

# Primary LLM Provider (Fast Tier - DeepSeek / OpenAI Compatible)
LLM_API_BASE=https://api.deepseek.com/v1
LLM_API_KEY=sk-your-real-deepseek-api-key
LLM_MODEL=deepseek-chat

# Optional Reasoning Tier (Reasoning Tier)
LLM_REASONING_MODEL=deepseek-reasoner
# LLM_REASONING_API_BASE=https://api.deepseek.com/v1
# LLM_REASONING_API_KEY=

# Frontend Public API Base URL (used at build/runtime in Next.js)
NEXT_PUBLIC_API_BASE=https://your-api-domain.com
